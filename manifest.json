{
  "manifest_version": 3,
  "name": "Auto Refresh Plus",
  "version": "1.2.0",
  "description": "A lightweight, reliable automated page refresher.",
  "permissions": ["activeTab", "alarms", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Refresh Plus"
  },
  "background": {
    "service_worker": "background.js"
  }
}